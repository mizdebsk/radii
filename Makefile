VERSION := $(shell git describe --tags --dirty --always 2>/dev/null || echo "dev")
MAN_SOURCES := $(sort $(wildcard man/*.[1-9]))

all: build

build:
	go build \
	    -ldflags="-X main.version=$(VERSION)" \
	    -o dist/bin/radii \
	    ./cmd/radii

test:
	go test ./...

MAN.md: $(MAN_SOURCES)
	{ \
		echo '<!-- Generated by make MAN.md; do not edit. -->'; \
		echo; \
		for f in $(MAN_SOURCES); do \
			mandoc -T markdown "$$f"; \
			echo; \
		done; \
	} | awk '{ \
		gsub(sprintf("%c", 31), " "); \
		gsub(/&nbsp;/, " "); \
		gsub(/&#8217;/, "\047"); \
		gsub(/&#x2019;/, "\047"); \
		gsub(/&#39;/, "\047"); \
		if ($$0 ~ /^\t\*\*[^*]+\*\* `[^`]*`$$/) { \
			line = substr($$0, 2); \
			name = line; \
			sub(/^\*\*/, "", name); \
			sub(/\*\* `.*$$/, "", name); \
			rest = line; \
			sub(/^\*\*[^*]+\*\* `/, "", rest); \
			sub(/`$$/, "", rest); \
			$$0 = "\t" name " " rest; \
		} \
		gsub(/\\\[/, "["); \
		gsub(/\\\]/, "]"); \
		print; \
	}' > $@

archive:
	go mod vendor
	tar czf radii-$(VERSION)-vendor.tar.gz vendor
	git archive HEAD --prefix radii-$(VERSION)/ | gzip -9 >radii-$(VERSION).tar.gz

clean:
	rm -rf dist

.PHONY: all build test archive clean
